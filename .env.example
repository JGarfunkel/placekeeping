# Copy this file to .env.local and fill in real values. .env.local is gitignored.

# --- Database (packages/db, apps/web server code) ---
DATABASE_URL=postgresql://placekeeper:placekeeper@localhost:5432/placekeeper

# --- Google Maps (apps/web) ---
# Public by necessity (used client-side) — restrict by HTTP referrer in the
# Google Cloud Console, do not treat this as a secret.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Optional: a Map ID from Google Cloud Console > Maps > Map Management,
# needed for Advanced Markers styling. Falls back to a default if unset.
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
# Optional: server-only default map center, used until the visitor shares
# their location or the query string carries one. Falls back to the
# geographic center of the contiguous U.S. if unset.
DEFAULT_MAP_CENTER_LAT=
DEFAULT_MAP_CENTER_LNG=

# --- Firebase client config (apps/web, public) ---
# From Firebase Console > Project settings > General > Your apps > SDK setup.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (apps/web, server-only secrets) ---
# From Firebase Console > Project settings > Service accounts > Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Keep the literal \n escapes; the app un-escapes them at runtime.
FIREBASE_ADMIN_PRIVATE_KEY=

# --- Photo moderation (packages/core, server-only) ---
# Selects the content-moderation check applied to observation photos
# (pasted URLs and uploads). "none" (the default) skips moderation entirely
# — no Vision call is made, and the GOOGLE_VISION_* vars below aren't
# needed. "google" enables Google Cloud Vision SafeSearch + text screening.
PHOTO_MODERATION=none

# --- Google Cloud Vision (packages/core, server-only secrets) ---
# Only required when PHOTO_MODERATION=google. Recommended: grant the
# existing Firebase Admin service account Vision API access in GCP Console
# (IAM & Admin > IAM) and paste the same values here — kept as a separate
# var trio so it's unambiguous which system consumes them, and so switching
# to a dedicated service account later is a one-line change. Requires
# enabling the Cloud Vision API on the project.
GOOGLE_VISION_PROJECT_ID=
GOOGLE_VISION_CLIENT_EMAIL=
# Keep the literal \n escapes; the app un-escapes them at runtime.
GOOGLE_VISION_PRIVATE_KEY=

# --- Photo storage (packages/core, server-only) ---
# Selects where uploaded observation photos are written. "local" writes to
# apps/web/public/uploads (dev/testing only — not for production: files
# aren't backed up and won't survive a redeploy on most hosts). "r2" uses
# Cloudflare R2 (S3 API-compatible). "s3" and "gcs" are accepted but not
# implemented yet.
IMAGE_STORAGE=local

# Base URL uploaded files are served from when IMAGE_STORAGE=local. Files
# land in apps/web/public/uploads and Next serves public/ at the site root,
# so this should be the app's own origin, e.g. http://localhost:3000.
LOCAL_UPLOADS_BASE_URL=http://localhost:3000

# --- Email (apps/web, server-only) ---
# Selects how verification/password-reset emails are delivered. "console"
# (the default) logs the email instead of sending it -- no account needed
# for local dev, but the emailed link only shows up in the server console.
# "resend" sends for real via Resend; see GO_LIVE_CHECKLIST.md.
EMAIL_PROVIDER=console
# The app's own origin, used to build the link a verification/reset email
# points at. Defaults to localhost if unset.
APP_BASE_URL=http://localhost:3000

# --- Resend (apps/web, server-only secrets) ---
# Only required when EMAIL_PROVIDER=resend. API key from Resend dashboard >
# API Keys. EMAIL_FROM must be an address on a domain verified in Resend
# (Domains > Add Domain), e.g. "Atlas <verify@yourdomain.com>".
RESEND_API_KEY=
EMAIL_FROM=

# --- Cloudflare R2 (packages/core, server-only secrets) ---
# Only required when IMAGE_STORAGE=r2. Create an API token under Cloudflare
# dashboard > R2 > Manage API Tokens (needs Object Read & Write on the bucket).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# The public read URL for the bucket — NOT the S3 API endpoint. Enable the
# free r2.dev subdomain (bucket Settings > Public Access) or attach a custom
# domain, and put that origin here, e.g. https://pub-xxxx.r2.dev. Objects
# are read back at {R2_PUBLIC_BASE_URL}/{key}.
R2_PUBLIC_BASE_URL=
